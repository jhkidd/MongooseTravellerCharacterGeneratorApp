  "mishaps": {
    "1": {
      "description": "Severely injured (treat as a result of 2 on the Injury Table). Alternatively, roll twice on the Injury Table and take the lower result.",
      "effects": {
        "type": "choice",
        "prompt": "You are severely injured. Choose how to resolve your injuries.",
        "options": [
          {
            "label": "Take the severity of a result of 2 (Severely injured)",
            "effects": [
              {
                "type": "rollOnTable",
                "table": "injury",
                "fixedResult": 2
              }
            ]
          },
          {
            "label": "Roll twice on the Injury table and take the lower result",
            "effects": [
              {
                "type": "rollOnTable",
                "table": "injury",
                "modifier": "takeLower"
              }
            ]
          }
        ]
      }
    },
    "2": {
      "description": "Injured. Roll on the Injury table.",
      "effects": {
        "type": "compound",
        "effects": [
          {
            "type": "ejectFromCareer"
          },
          {
            "type": "rollOnTable",
            "table": "injury"
          }
        ]
      }
    },
    "3": {
      "description": "You run afoul of a criminal gang, corrupt bureaucrat or other foe. Gain an enemy.",
      "effects": {
        "type": "compound",
        "effects": [
          {
            "type": "ejectFromCareer"
          },
          {
            "type": "gainContact",
            "contactType": "enemy"
          }
        ]
      }
    },
    "4": {
      "description": "You suffer from a life-threatening illness. Reduce your END by 1.",
      "effects": {
        "type": "compound",
        "effects": [
          {
            "type": "ejectFromCareer"
          },
          {
            "type": "modCharacteristic",
            "characteristic": "END",
            "value": -1
          }
        ]
      }
    },
    "5": {
      "description": "Betrayed by a friend. One of your Contacts or Allies betrays you, ending your career. That Contact or Ally becomes an Enemy or Rival. If you have no Contacts or Allies, then you are betrayed by someone you never saw coming and still gain a Rival or Enemy. In addition, roll 2D. If you roll a 2, you must take the prisoner career in your next term.",
      "effects": {
        "type": "compound",
        "effects": [
          {
            "type": "ejectFromCareer"
          },
          {
            "type": "narrative",
            "prompt": "One of your Contacts or Allies betrays you (or, if you have none, someone unexpected does). That character becomes an Enemy or Rival."
          },
          {
            "type": "gainContact",
            "contactType": "enemy"
          },
          {
            "type": "narrative",
            "prompt": "Roll 2D6: on a natural 2, you must take the Prisoner career in your next term (note this manually)."
          }
        ]
      }
    },
    "6": {
      "description": "You do not know what happened to you. There is a gap in your memory.",
      "effects": {
        "type": "none"
      }
    }
  },
  "events": {
    "2": {
      "description": "Disaster! Roll on the Mishap Table, but you are not ejected from this career.",
      "effects": {
        "type": "rollOnTable",
        "table": "mishap"
      }
    },
    "3": {
      "description": "A patron offers you a chance at a job. If you accept, you gain DM+4 to your next qualification roll but you owe that patron a favour.",
      "effects": {
        "type": "choice",
        "prompt": "A patron offers you a chance at a job.",
        "options": [
          {
            "label": "Accept (DM+4 to next qualification roll, but you owe a favour)",
            "effects": [
              {
                "type": "narrative",
                "prompt": "You gain DM+4 to your next Qualification roll (note manually; qualification DM bonuses are not yet tracked by the engine) but you owe the patron a favour."
              }
            ]
          },
          {
            "label": "Decline",
            "effects": [
              {
                "type": "none"
              }
            ]
          }
        ]
      }
    },
    "4": {
      "description": "You pick up a few useful skills here and there. Gain one level of Jack-of-all-Trades, Survival, Streetwise or Melee (any).",
      "effects": {
        "type": "pickOne",
        "prompt": "Choose one skill to gain at level 1:",
        "options": [
          {
            "label": "Jack-of-all-Trades 1",
            "effect": {
              "type": "gainSkill",
              "skill": "Jack-of-all-Trades",
              "level": 1
            }
          },
          {
            "label": "Survival 1",
            "effect": {
              "type": "gainSkill",
              "skill": "Survival",
              "level": 1
            }
          },
          {
            "label": "Streetwise 1",
            "effect": {
              "type": "gainSkill",
              "skill": "Streetwise",
              "level": 1
            }
          },
          {
            "label": "Melee 1",
            "effect": {
              "type": "gainSkill",
              "skill": "Melee",
              "level": 1
            }
          }
        ]
      }
    },
    "5": {
      "description": "You manage to scavenge something of use. Gain DM+1 to any one Benefit roll.",
      "effects": {
        "type": "gainBenefitDM",
        "value": 1
      }
    },
    "6": {
      "description": "You encounter something unusual. Go to the Life Events table and have an Unusual Event.",
      "effects": {
        "type": "rollOnTable",
        "table": "life-events",
        "fixedResult": 12
      }
    },
    "7": {
      "description": "Life Event. Roll on the Life Events Table.",
      "effects": {
        "type": "rollOnTable",
        "table": "life-events"
      }
    },
    "8": {
      "description": "You are attacked by enemies. Gain an Enemy if you do not have one already, and roll either Melee 8+, Gun Combat 8+ or Stealth 8+ to avoid a roll on the Injury Table.",
      "effects": {
        "type": "compound",
        "effects": [
          {
            "type": "gainContact",
            "contactType": "enemy"
          },
          {
            "type": "pickOne",
            "prompt": "Choose which skill to roll to avoid injury:",
            "options": [
              {
                "label": "Melee 8+",
                "effect": {
                  "type": "skillCheck",
                  "skill": "Melee",
                  "target": 8,
                  "success": {
                    "type": "none"
                  },
                  "failure": {
                    "type": "rollOnTable",
                    "table": "injury"
                  }
                }
              },
              {
                "label": "Gun Combat 8+",
                "effect": {
                  "type": "skillCheck",
                  "skill": "Gun Combat",
                  "target": 8,
                  "success": {
                    "type": "none"
                  },
                  "failure": {
                    "type": "rollOnTable",
                    "table": "injury"
                  }
                }
              },
              {
                "label": "Stealth 8+",
                "effect": {
                  "type": "skillCheck",
                  "skill": "Stealth",
                  "target": 8,
                  "success": {
                    "type": "none"
                  },
                  "failure": {
                    "type": "rollOnTable",
                    "table": "injury"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    "9": {
      "description": "You are offered a chance to take part in a risky but rewarding adventure. If you accept, roll 1D: On a 1-2 you are injured or arrested; either roll on the injury table or take the prisoner career in you next term. On 3-4, you survive, but gain nothing. On a 5-6, you succeed and gain DM+4 to one Benefit roll.",
      "effects": {
        "type": "narrative",
        "prompt": "You are offered a chance to take part in a risky but rewarding adventure. If you accept, roll 1D: 1-2 you are injured or arrested (roll on the Injury table, or take the Prisoner career next term); 3-4 you survive but gain nothing; 5-6 you gain DM+4 to one Benefit roll. Resolve this manually."
      }
    },
    "10": {
      "description": "Life on the edge hones your abilities. Increase any skill you already have by one level.",
      "effects": {
        "type": "increaseExistingSkill"
      }
    },
    "11": {
      "description": "You are forcibly drafted. Roll for the Draft next term.",
      "effects": {
        "type": "narrative",
        "prompt": "You are forcibly drafted. Roll for the Draft next term (resolve manually)."
      }
    },
    "12": {
      "description": "You thrive on adversity. You are automatically promoted.",
      "effects": {
        "type": "autoPromote"
      }
    }
  },
