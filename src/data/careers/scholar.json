  "mishaps": {
    "1": {
      "description": "Severely injured (treat as a result of 2 on the Injury Table). Alternatively, roll twice on the Injury Table and take the lower result.",
      "effects": {
        "type": "choice",
        "prompt": "You are severely injured. Choose how to resolve your injuries.",
        "options": [
          {
            "label": "Take the severity of a result of 2 (Severely injured)",
            "effects": [
              {
                "type": "rollOnTable",
                "table": "injury",
                "fixedResult": 2
              }
            ]
          },
          {
            "label": "Roll twice on the Injury table and take the lower result",
            "effects": [
              {
                "type": "rollOnTable",
                "table": "injury",
                "modifier": "takeLower"
              }
            ]
          }
        ]
      }
    },
    "2": {
      "description": "One of your experiments goes disastrously wrong. Reduce one physical characteristic by 1 and lose your Benefit rolls from this term.",
      "effects": {
        "type": "none"
      }
    },
    "3": {
      "description": "Your research is discredited \u2014 you may have committed fraud, or simply been unlucky. Lose 1 SOC and gain a Rival.",
      "effects": {
        "type": "none"
      }
    },
    "4": {
      "description": "A patient, subject, or colleague dies as a result of your work. Gain an Enemy among their family or colleagues.",
      "effects": {
        "type": "none"
      }
    },
    "5": {
      "description": "Your funding is pulled or your institution disbands your department. You must muster out.",
      "effects": {
        "type": "none"
      }
    },
    "6": {
      "description": "Injured. Roll on the Injury Table.",
      "effects": {
        "type": "compound",
        "effects": [
          {
            "type": "ejectFromCareer"
          },
          {
            "type": "rollOnTable",
            "table": "injury"
          }
        ]
      }
    }
  },
  "events": {
    "2": {
      "description": "Disaster! Roll on the Mishap Table, but you are not ejected from this career.",
      "effects": {
        "type": "rollOnTable",
        "table": "mishap"
      }
    },
    "3": {
      "description": "A research expedition goes wrong. Roll Survival 8+ or Medic 8+; on success, gain one level in that skill. On failure, lose 1 END.",
      "effects": {
        "type": "none"
      }
    },
    "4": {
      "description": "You take part in a major interdisciplinary project. Gain one of Science 1, Engineer 1, Medic 1 or Electronics 1.",
      "effects": {
        "type": "none"
      }
    },
    "5": {
      "description": "You present a paper or give a lecture that is well-received. Gain DM+1 to any one Benefit roll.",
      "effects": {
        "type": "none"
      }
    },
    "6": {
      "description": "You make a valuable Contact in academia, industry, or government.",
      "effects": {
        "type": "none"
      }
    },
    "7": {
      "description": "Life Event. Roll on the Life Events Table.",
      "effects": {
        "type": "rollOnTable",
        "table": "life-events"
      }
    },
    "8": {
      "description": "You are given specialised training or fellowship. Roll EDU 8+ to gain one level in any Science specialty of your choice.",
      "effects": {
        "type": "none"
      }
    },
    "9": {
      "description": "A rival researcher tries to scoop your work. Roll INT 8+ to publish first; on success, gain DM+2 to your next Advancement. On failure, gain a Rival.",
      "effects": {
        "type": "none"
      }
    },
    "10": {
      "description": "Your research or practice attracts the notice of a powerful patron. Gain an Ally and DM+2 to your next Advancement check.",
      "effects": {
        "type": "none"
      }
    },
    "11": {
      "description": "You are invited to join a major institution or expedition. Either gain one level of Admin, Advocate or Diplomat, or DM+4 to your next Advancement roll.",
      "effects": {
        "type": "none"
      }
    },
    "12": {
      "description": "Your work is of Imperial significance \u2014 a breakthrough, discovery or cure. You are automatically promoted and gain DM+2 to any one Benefit roll.",
      "effects": {
        "type": "none"
      }
    }
  },
