  "mishaps": {
    "1": {
      "description": "Severely injured in action (treat as a result of 2 on the Injury Table). Alternatively, roll twice on the Injury Table and take the lower result.",
      "effects": {
        "type": "choice",
        "prompt": "You are severely injured. Choose how to resolve your injuries.",
        "options": [
          {
            "label": "Take the severity of a result of 2 (Severely injured)",
            "effects": [
              {
                "type": "rollOnTable",
                "table": "injury",
                "fixedResult": 2
              }
            ]
          },
          {
            "label": "Roll twice on the Injury table and take the lower result",
            "effects": [
              {
                "type": "rollOnTable",
                "table": "injury",
                "modifier": "takeLower"
              }
            ]
          }
        ]
      }
    },
    "2": {
      "description": "Your ship is destroyed in a battle, misjump or accident. You are one of the few survivors. Gain a fellow survivor as a Contact.",
      "effects": {
        "type": "none"
      }
    },
    "3": {
      "description": "You are disgraced by the actions of your ship, your captain, or yourself. Gain a Rival in the service.",
      "effects": {
        "type": "none"
      }
    },
    "4": {
      "description": "You are court-martialled for a real or imagined offence. Whether or not you are convicted, you are forced out of the service.",
      "effects": {
        "type": "none"
      }
    },
    "5": {
      "description": "A political scandal or shift in Imperial policy ends your career. Gain an Enemy among the admiralty.",
      "effects": {
        "type": "none"
      }
    },
    "6": {
      "description": "Injured. Roll on the Injury Table.",
      "effects": {
        "type": "compound",
        "effects": [
          {
            "type": "ejectFromCareer"
          },
          {
            "type": "rollOnTable",
            "table": "injury"
          }
        ]
      }
    }
  },
  "events": {
    "2": {
      "description": "Disaster! Roll on the Mishap Table, but you are not ejected from this career.",
      "effects": {
        "type": "rollOnTable",
        "table": "mishap"
      }
    },
    "3": {
      "description": "Your ship engages an enemy vessel. Roll Gunner 8+ or Tactics (Naval) 8+; on success, gain one of Gunner 1 or Tactics (Naval) 1 and DM+1 to your next Advancement roll. On failure, roll on the Mishap Table (not ejected).",
      "effects": {
        "type": "none"
      }
    },
    "4": {
      "description": "You are assigned to an isolated, long-range patrol. Gain one of Astrogation 1, Survival 1, Electronics 1 or Vacc Suit 1.",
      "effects": {
        "type": "none"
      }
    },
    "5": {
      "description": "You are given a commendation. Gain DM+1 to any one Benefit roll.",
      "effects": {
        "type": "none"
      }
    },
    "6": {
      "description": "You serve aboard a ship with an excellent captain. Gain them as a Contact or Ally.",
      "effects": {
        "type": "none"
      }
    },
    "7": {
      "description": "Life Event. Roll on the Life Events Table.",
      "effects": {
        "type": "rollOnTable",
        "table": "life-events"
      }
    },
    "8": {
      "description": "You are sent to officer training or specialist school. Roll EDU 8+ to gain any one skill from the Officer or Advanced Education tables at level 1.",
      "effects": {
        "type": "none"
      }
    },
    "9": {
      "description": "You distinguish yourself in a ship-to-ship engagement. Gain DM+2 to your next Advancement roll.",
      "effects": {
        "type": "none"
      }
    },
    "10": {
      "description": "You are transferred to an elite unit. Gain one of Gun Combat 1, Melee (Blade) 1, Vacc Suit 1 or Leadership 1, or transfer to the Marines without a Qualification roll.",
      "effects": {
        "type": "none"
      }
    },
    "11": {
      "description": "You are given advanced training in a specialist field. Gain one level in any skill you already have, or DM+4 to your next Advancement roll.",
      "effects": {
        "type": "none"
      }
    },
    "12": {
      "description": "Your heroism in a major fleet action is noted by the Imperial court. You are automatically promoted and gain a medal.",
      "effects": {
        "type": "none"
      }
    }
  },
