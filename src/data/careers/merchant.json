  "mishaps": {
    "1": {
      "description": "Severely injured (treat as a result of 2 on the Injury Table). Alternatively, roll twice on the Injury Table and take the lower result.",
      "effects": {
        "type": "choice",
        "prompt": "You are severely injured. Choose how to resolve your injuries.",
        "options": [
          {
            "label": "Take the severity of a result of 2 (Severely injured)",
            "effects": [
              {
                "type": "rollOnTable",
                "table": "injury",
                "fixedResult": 2
              }
            ]
          },
          {
            "label": "Roll twice on the Injury table and take the lower result",
            "effects": [
              {
                "type": "rollOnTable",
                "table": "injury",
                "modifier": "takeLower"
              }
            ]
          }
        ]
      }
    },
    "2": {
      "description": "Your ship is attacked by pirates, corsairs or competitors. Gain an Enemy; if you survive, you lose all Benefits from this term.",
      "effects": {
        "type": "none"
      }
    },
    "3": {
      "description": "A cargo deal collapses catastrophically, leaving you in debt. Your Benefit rolls from this term are forfeit and you must muster out.",
      "effects": {
        "type": "none"
      }
    },
    "4": {
      "description": "You are caught up in a political or legal dispute that costs you your position. Gain a Rival and muster out.",
      "effects": {
        "type": "none"
      }
    },
    "5": {
      "description": "Your ship is impounded, lost, or destroyed in a misjump. Gain one less Benefit roll this career.",
      "effects": {
        "type": "none"
      }
    },
    "6": {
      "description": "Injured. Roll on the Injury Table.",
      "effects": {
        "type": "compound",
        "effects": [
          {
            "type": "ejectFromCareer"
          },
          {
            "type": "rollOnTable",
            "table": "injury"
          }
        ]
      }
    }
  },
  "events": {
    "2": {
      "description": "Disaster! Roll on the Mishap Table, but you are not ejected from this career.",
      "effects": {
        "type": "rollOnTable",
        "table": "mishap"
      }
    },
    "3": {
      "description": "Your ship is attacked. Roll Gun Combat 8+ or Gunner 8+ to escape; on failure, roll on the Mishap Table (not ejected). Either way, gain an Enemy.",
      "effects": {
        "type": "none"
      }
    },
    "4": {
      "description": "You spend several years trading on the fringes of Imperial space. Gain one of Streetwise 1, Broker 1, Diplomat 1 or Carouse 1.",
      "effects": {
        "type": "none"
      }
    },
    "5": {
      "description": "You make a lucrative deal. Gain DM+1 to any one Benefit roll.",
      "effects": {
        "type": "none"
      }
    },
    "6": {
      "description": "You travel extensively and broaden your horizons. Gain one of Language 1, Pilot (Spacecraft) 1, Astrogation 1 or Steward 1.",
      "effects": {
        "type": "none"
      }
    },
    "7": {
      "description": "Life Event. Roll on the Life Events Table.",
      "effects": {
        "type": "rollOnTable",
        "table": "life-events"
      }
    },
    "8": {
      "description": "You strike a long-term cargo agreement with a major client. Gain an Ally and DM+1 to any one Benefit roll, or DM+2 to your next Advancement check.",
      "effects": {
        "type": "none"
      }
    },
    "9": {
      "description": "You are pursued by creditors, authorities or pirates. Roll Pilot 8+ or Deception 8+; on success, gain a Contact among the Imperial Starport Authority. On failure, gain an Enemy and roll on the Mishap Table (not ejected).",
      "effects": {
        "type": "none"
      }
    },
    "10": {
      "description": "You become well-known for your dealings on a particular route. Gain DM+2 to your next Advancement check.",
      "effects": {
        "type": "none"
      }
    },
    "11": {
      "description": "You are entrusted with a particularly valuable or sensitive cargo. Either gain one level of Diplomat, Broker or Advocate, or DM+4 to your next Advancement roll.",
      "effects": {
        "type": "none"
      }
    },
    "12": {
      "description": "You pull off the deal of a lifetime. You are automatically promoted and gain DM+2 to any one Benefit roll.",
      "effects": {
        "type": "none"
      }
    }
  },
