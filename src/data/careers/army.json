        "2": { "type": "skill", "skill": "Drive" },
        "3": { "type": "skill", "skill": "Flyer" },
        "4": { "type": "skill", "skill": "Explosives" },
        "5": { "type": "skill", "skill": "Electronics", "specialty": "Comms" },
        "6": { "type": "skill", "skill": "Medic" }
