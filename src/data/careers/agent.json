    "11": {
      "description": "You are befriended by a senior agent. Either increase Investigate by one level or DM+4 to your next Advancement roll thanks to their aid.",
      "effects": {
        "type": "choice",
        "prompt": "A senior agent befriends you.",
        "options": [
          {
            "label": "Gain Investigate 1",
            "effects": [
              {
                "type": "increaseSkill",
