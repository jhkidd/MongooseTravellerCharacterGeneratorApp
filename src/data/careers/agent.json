              }
            ]
          },
          {
            "label": "Gain DM+4 to next Advancement",
            "effects": [
              {
                "type": "gainAdvancementDM",
                "value": 4
              }
            ]
          }
        ]
      }
    },
    "12": {
      "description": "Your efforts uncover a major conspiracy against your employers. You are automatically promoted.",
      "effects": {
        "type": "autoPromote"
      }
    }
