  "mishaps": {
    "1": {
      "description": "Severely injured (treat as a result of 2 on the Injury Table). Alternatively, roll twice on the Injury Table and take the lower result.",
      "effects": {
        "type": "choice",
        "prompt": "You are severely injured. Choose how to resolve your injuries.",
        "options": [
          {
            "label": "Take the severity of a result of 2 (Severely injured)",
            "effects": [
              {
                "type": "rollOnTable",
                "table": "injury",
                "fixedResult": 2
              }
            ]
          },
          {
            "label": "Roll twice on the Injury table and take the lower result",
            "effects": [
              {
                "type": "rollOnTable",
                "table": "injury",
                "modifier": "takeLower"
              }
            ]
          }
        ]
      }
    },
    "2": {
      "description": "You are arrested and sent to prison. You must muster out, and any Benefit rolls from this term are forfeit.",
      "effects": {
        "type": "none"
      }
    },
    "3": {
      "description": "A job goes spectacularly wrong. Gain an Enemy and lose all Benefit rolls from this term.",
      "effects": {
        "type": "none"
      }
    },
    "4": {
      "description": "You betray \u2014 or are betrayed by \u2014 a partner in crime. Gain them as an Enemy.",
      "effects": {
        "type": "none"
      }
    },
    "5": {
      "description": "A rival criminal organisation targets you and you are forced to flee or go straight. Muster out.",
      "effects": {
        "type": "none"
      }
    },
    "6": {
      "description": "Injured. Roll on the Injury Table.",
      "effects": {
        "type": "compound",
        "effects": [
          {
            "type": "ejectFromCareer"
          },
          {
            "type": "rollOnTable",
            "table": "injury"
          }
        ]
      }
    }
  },
  "events": {
    "2": {
      "description": "Disaster! Roll on the Mishap Table, but you are not ejected from this career.",
      "effects": {
        "type": "rollOnTable",
        "table": "mishap"
      }
    },
    "3": {
      "description": "A job goes wrong and you are pursued by the law. Roll Stealth 8+ or Deception 8+ to escape. On failure, roll on the Mishap Table (not ejected). Either way, gain an Enemy in law enforcement.",
      "effects": {
        "type": "none"
      }
    },
    "4": {
      "description": "You befriend a fence, crime boss, or fellow criminal. Gain a Contact or Ally in the underworld.",
      "effects": {
        "type": "none"
      }
    },
    "5": {
      "description": "You pull off a lucrative heist. Gain DM+2 to any one Benefit roll.",
      "effects": {
        "type": "none"
      }
    },
    "6": {
      "description": "You spend time working the shadows of a particular world. Gain one of Streetwise 1, Stealth 1, Deception 1 or Persuade 1.",
      "effects": {
        "type": "none"
      }
    },
    "7": {
      "description": "Life Event. Roll on the Life Events Table.",
      "effects": {
        "type": "rollOnTable",
        "table": "life-events"
      }
    },
    "8": {
      "description": "You are given a delicate job by a major criminal syndicate. Roll Stealth 8+ or Deception 8+; on success, gain a Contact in the syndicate and DM+2 to your next Advancement. On failure, gain an Enemy and roll on the Mishap Table (not ejected).",
      "effects": {
        "type": "none"
      }
    },
    "9": {
      "description": "You clash with law enforcement. Roll Streetwise 8+ or Gun Combat 8+ to escape; on failure, gain an Enemy in the Agents and a Rival on the streets.",
      "effects": {
        "type": "none"
      }
    },
    "10": {
      "description": "You earn a reputation in the underworld. Gain DM+2 to your next Advancement roll.",
      "effects": {
        "type": "none"
      }
    },
    "11": {
      "description": "You acquire specialist knowledge or equipment. Either gain one level of Gun Combat, Stealth, Electronics or Melee, or DM+4 to your next Advancement roll.",
      "effects": {
        "type": "none"
      }
    },
    "12": {
      "description": "You pull off a caper that becomes legendary. You are automatically promoted and gain DM+2 to any one Benefit roll.",
      "effects": {
        "type": "none"
      }
    }
  },
