  "mishaps": {
    "1": {
      "description": "Severely injured (treat as a result of 2 on the Injury Table). Alternatively, roll twice on the Injury Table and take the lower result.",
      "effects": {
        "type": "choice",
        "prompt": "You are severely injured. Choose how to resolve your injuries.",
        "options": [
          {
            "label": "Take the severity of a result of 2 (Severely injured)",
            "effects": [
              {
                "type": "rollOnTable",
                "table": "injury",
                "fixedResult": 2
              }
            ]
          },
          {
            "label": "Roll twice on the Injury table and take the lower result",
            "effects": [
              {
                "type": "rollOnTable",
                "table": "injury",
                "modifier": "takeLower"
              }
            ]
          }
        ]
      }
    },
    "2": {
      "description": "You are harassed and your life ruined by a criminal gang. Gain the gang as an enemy.",
      "effects": {
        "type": "none"
      }
    },
    "3": {
      "description": "Hard times caused by a lack of interstellar trade costs you your job. Lose one SOC.",
      "effects": {
        "type": "none"
      }
    },
    "4": {
      "description": "Your business is investigated by the planetary authorities (or your colony suffers interference from interests offworld). Co-operate and the business or colony is shut down but you gain DM+2 to the qualification roll for your next career as a reward for your aid. Refuse and gain an Ally.",
      "effects": {
        "type": "none"
      }
    },
    "5": {
      "description": "A revolution, attack or other unusual event throws your life into chaos, forcing you to leave the planet. Roll streetwise 8+. If you succeed, increase any skill you have by one level.",
      "effects": {
        "type": "none"
      }
    },
    "6": {
      "description": "Injured. Roll on the Injury Table.",
      "effects": {
        "type": "compound",
        "effects": [
          {
            "type": "ejectFromCareer"
          },
          {
            "type": "rollOnTable",
            "table": "injury"
          }
        ]
      }
    }
  },
  "events": {
    "2": {
      "description": "Disaster! Roll on the Mishap Table, but you are not ejected from this career.",
      "effects": {
        "type": "rollOnTable",
        "table": "mishap"
      }
    },
    "3": {
      "description": "Political upheaval strikes your homeworld and you are caught up in the revolution. Gain either Advocate 1, Persuade 1, Explosives 1 or Streetwise 1. Roll whichever skill you chose 8+. If you succeed you come out on the winning side and gain DM+2 to your next advancement roll. Fail and you suffer DM-2 on your next Survival roll.",
      "effects": {
        "type": "none"
      }
    },
    "4": {
      "description": "You spend time maintaining and using heavy vehicles, either as part of your job or as a hobby. Increase Mechanic, Drive, Electronics, Flyer or Engineer by one level.",
      "effects": {
        "type": "pickOne",
        "prompt": "Choose which skill to increase by one level:",
        "options": [
          {
            "label": "Mechanic",
            "effect": {
              "type": "increaseSkill",
              "skill": "Mechanic"
            }
          },
          {
            "label": "Drive",
            "effect": {
              "type": "increaseSkill",
              "skill": "Drive"
            }
          },
          {
            "label": "Electronics",
            "effect": {
              "type": "increaseSkill",
              "skill": "Electronics"
            }
          },
          {
            "label": "Flyer",
            "effect": {
              "type": "increaseSkill",
              "skill": "Flyer"
            }
          },
          {
            "label": "Engineer",
            "effect": {
              "type": "increaseSkill",
              "skill": "Engineer"
            }
          }
        ]
      }
    },
    "5": {
      "description": "You business expands, your corporation grows or the colony thrives. Gain DM+1 to any one Benefit roll.",
      "effects": {
        "type": "gainBenefitDM",
        "value": 1
      }
    },
    "6": {
      "description": "You are given advanced training in a specialist field. Roll EDU 10+ to gain any one skill of your choice at level 1.",
      "effects": {
        "type": "skillCheck",
        "characteristic": "EDU",
        "target": 10,
        "success": {
          "type": "pickSkill",
          "options": [
            "Admin",
            "Advocate",
            "Animals",
            "Art",
            "Astrogation",
            "Athletics",
            "Broker",
            "Carouse",
            "Deception",
            "Diplomat",
            "Drive",
            "Electronics",
            "Engineer",
            "Explosives",
            "Flyer",
            "Gambler",
            "Gun Combat",
            "Gunner",
            "Heavy Weapons",
            "Investigate",
            "Jack-of-all-Trades",
            "Language",
            "Leadership",
            "Mechanic",
            "Medic",
            "Melee",
            "Navigation",
            "Persuade",
            "Pilot",
            "Profession",
            "Recon",
            "Science",
            "Seafarer",
            "Stealth",
            "Steward",
            "Streetwise",
            "Survival",
            "Tactics",
            "Vacc Suit"
          ],
          "level": 1
        },
        "failure": {
          "type": "none"
        }
      }
    },
    "7": {
      "description": "Life Event. Roll on the Life Events Table.",
      "effects": {
        "type": "rollOnTable",
        "table": "life-events"
      }
    },
    "8": {
      "description": "You learn something you should not have - a corporate secret, a political scandal - which you can profit from illegally. If you choose to do so, then you gain DM+1 to a benefit roll from this career and gain Streetwise 1, Deception 1 or a criminal Contact. If you refuse you gain nothing.",
      "effects": {
        "type": "choice",
        "prompt": "You learn a valuable secret. Do you profit from it illegally?",
        "options": [
          {
            "label": "Profit from it",
            "effects": [
              {
                "type": "gainBenefitDM",
                "value": 1
              },
              {
                "type": "pickOne",
                "prompt": "Choose your reward:",
                "options": [
                  {
                    "label": "Streetwise 1",
                    "effect": {
                      "type": "gainSkill",
                      "skill": "Streetwise",
                      "level": 1
                    }
                  },
                  {
                    "label": "Deception 1",
                    "effect": {
                      "type": "gainSkill",
                      "skill": "Deception",
                      "level": 1
                    }
                  },
                  {
                    "label": "A criminal Contact",
                    "effect": {
                      "type": "gainContact",
                      "contactType": "contact"
                    }
                  }
                ]
              }
            ]
          },
          {
            "label": "Refuse (gain nothing)",
            "effects": [
              {
                "type": "none"
              }
            ]
          }
        ]
      }
    },
    "9": {
      "description": "You are rewarded for your diligence or cunning. Gain DM+2 to your next advancement roll.",
      "effects": {
        "type": "gainAdvancementDM",
        "value": 2
      }
    },
    "10": {
      "description": "You gain experience in a technical field as a computer operator or surveyor. Increase Electronics or Engineer by one level.",
      "effects": {
        "type": "pickOne",
        "prompt": "Choose which skill to increase by one level:",
        "options": [
          {
            "label": "Electronics",
            "effect": {
              "type": "increaseSkill",
              "skill": "Electronics"
            }
          },
          {
            "label": "Engineer",
            "effect": {
              "type": "increaseSkill",
              "skill": "Engineer"
            }
          }
        ]
      }
    },
    "11": {
      "description": "You befriend a superior in the corporation or colony. Gain an Ally. Either gain Diplomat 1 or DM+4 to your next advancement roll thanks to their aid.",
      "effects": {
        "type": "compound",
        "effects": [
          {
            "type": "gainContact",
            "contactType": "ally"
          },
          {
            "type": "pickOne",
            "prompt": "Choose your reward:",
            "options": [
              {
                "label": "Gain Diplomat 1",
                "effect": {
                  "type": "gainSkill",
                  "skill": "Diplomat",
                  "level": 1
                }
              },
              {
                "label": "DM+4 to your next Advancement roll",
                "effect": {
                  "type": "gainAdvancementDM",
                  "value": 4
                }
              }
            ]
          }
        ]
      }
    },
    "12": {
      "description": "You rise to a position of power in your colony or corporation. You are automatically promoted.",
      "effects": {
        "type": "autoPromote"
      }
    }
  },
